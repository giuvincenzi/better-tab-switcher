{
  "name": "better-tab-switcher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check . && npm run compile",
    "test": "vitest run",
    "e2e": "wxt build --mode e2e && playwright test",
    "postinstall": "wxt prepare",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.1",
    "@wxt-dev/i18n": "^0.2.8",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@wxt-dev/module-solid": "^1.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
